NODE_ENV=
PORT=

# Opcional — override explícito de uma única origem permitida pelo CORS.
# Quando vazio (default), o backend libera http://localhost:4200 e qualquer
# IP de rede privada (192.168.x.x, 10.x.x.x, 172.16-31.x.x) na porta 4200,
# para permitir abrir o app do celular na mesma wifi do PC.
CORS_ORIGIN=

# Diretório raiz dos arquivos enviados (fotos/vídeos da evolução da obra).
# Opcional — quando vazio, usa ./uploads relativo à pasta do backend.
UPLOAD_DIR=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

DATABASE_URL=
