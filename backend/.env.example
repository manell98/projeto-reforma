# Aplicação
NODE_ENV=development
PORT=3000

# CORS (origem permitida do frontend)
CORS_ORIGIN=http://localhost:4200

# Banco de dados (usados pelo docker-compose.yml)
POSTGRES_USER=reforma
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reforma_db
POSTGRES_PORT=5432

# String de conexão usada pelo Prisma
DATABASE_URL="postgresql://reforma:change-me@localhost:5432/reforma_db?schema=public"
