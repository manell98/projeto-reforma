generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Categorias de gasto da reforma. Enum fixo (não uma tabela própria) porque a
// lista é um domínio fechado definido pelo produto, não um cadastro do usuário.
enum Categoria {
  ELETRODOMESTICOS
  MATERIAIS
  PEDREIRO
  ELETRICISTA
  MARCENEIRO
  MARMOREIRO
  SERRALHEIRO
  VIDRACEIRO
  LADRILHEIRO
  INSTALADOR_PORTA
  TIO_NEGUINHO
  ALUGUEL_MATERIAIS
  REMOCAO_ENTULHO
  ARQUITETO
  OUTROS
}

// Forma de pagamento estruturada da despesa. Substitui a antiga inferência
// por parsing da observação (texto livre) — a partir de agora é a única
// fonte de verdade para a aba "Formas de pagamento". Nullable porque
// despesas cadastradas antes desse campo existir não têm essa informação
// e devem aparecer como "não informado", nunca deduzida da observação.
enum FormaPagamento {
  PIX
  CARTAO_CREDITO
}

model Expense {
  id             String          @id @default(uuid())
  valor          Decimal         @db.Decimal(12, 2)
  descricao      String
  categoria      Categoria
  data           DateTime        @db.Date
  observacao     String?
  formaPagamento FormaPagamento?
  parcelas       Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([data])
  @@index([categoria])
  @@map("expenses")
}

// Orçamento geral da reforma e cinco orçamentos específicos (Pedreiro,
// Eletricista, Tio Neguinho, Marceneiro, Marmoreiro), cada um uma linha única
// identificada por `tipo`. Os valores destinados aos cinco específicos
// representam dinheiro RESERVADO dentro do orçamento geral — não são
// despesas. Os gastos efetivos de cada um vêm das próprias `Expense` cuja
// `categoria` bate com o tipo, sem CRUD próprio: ver `ExpensesModule`.
enum OrcamentoTipo {
  GERAL
  PEDREIRO
  ELETRICISTA
  TIO_NEGUINHO
  MARCENEIRO
  MARMOREIRO
}

model Orcamento {
  tipo      OrcamentoTipo @id
  valor     Decimal       @db.Decimal(12, 2)
  updatedAt DateTime      @updatedAt

  @@map("orcamento")
}

// Linha única com as datas de início/término da obra.
model Obra {
  id          Int       @id @default(1)
  dataInicio  DateTime? @db.Date
  dataTermino DateTime? @db.Date
  updatedAt   DateTime  @updatedAt

  @@map("obra")
}

// --- Evolução da obra ----------------------------------------------------
// Registros de foto/vídeo do andamento da obra. O arquivo em si fica no
// disco (dentro de UPLOAD_DIR/evolucao), não no banco — aqui ficam só os
// metadados e o caminho relativo gerado pelo servidor.
enum TipoMidia {
  FOTO
  VIDEO
}

// De onde veio a data de captura exibida: do EXIF da própria foto, da data
// de modificação do arquivo, ou digitada à mão pelo usuário. Guardada para
// a UI conseguir dizer o quão confiável é a data cronológica do registro.
enum OrigemDataCaptura {
  EXIF
  ARQUIVO
  MANUAL
}

model RegistroObra {
  id String @id @default(uuid())

  titulo    String?
  descricao String?
  tipo      TipoMidia

  // `arquivoNome` é só o nome original enviado pelo usuário (metadado de
  // exibição); o caminho real em disco (`arquivoPath`) é sempre gerado pelo
  // servidor (uuid + extensão derivada do mime), nunca do nome do usuário.
  arquivoNome  String
  arquivoPath  String
  mimeType     String
  tamanhoBytes Int

  // Quando a foto/vídeo foi TIRADA (data de calendário, igual a Expense.data),
  // distinta de `createdAt`, que é o instante do upload.
  dataCaptura       DateTime          @db.Date
  origemDataCaptura OrigemDataCaptura

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dataCaptura])
  @@map("registros_obra")
}
